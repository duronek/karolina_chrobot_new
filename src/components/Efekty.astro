---
// Efekty interakcji wspólne dla całej strony:
//  – ślad pędzla za kursorem (kolory farb z palety),
//  – przechylanie ramek 3D z odblaskiem światła ([data-tilt]),
//  – „magnetyczne” przyciski ([data-magnetic]),
//  – pasek postępu przewijania.
// Wszystko wyłącza się przy prefers-reduced-motion, a ślad pędzla i przechylanie także na ekranach dotykowych.
---

<div class="progress" aria-hidden="true"></div>
<canvas class="paint-trail" aria-hidden="true" transition:persist></canvas>

<script>
  const ruch = matchMedia('(prefers-reduced-motion: no-preference)');
  const mysz = matchMedia('(hover: hover) and (pointer: fine)');

  /* ---------- Ślad pędzla ---------- */
  type Punkt = { x: number; y: number; t: number; w: number };
  type Pociagniecie = { kolor: string; punkty: Punkt[] };

  const ZANIK = 900; // ms, po których farba znika
  const GRUBOSC = 11;
  const PRZERWA = 120; // ms bez ruchu = nowe pociągnięcie (w nowym kolorze)

  const initPaint = () => {
    const canvas = document.querySelector<HTMLCanvasElement>('.paint-trail');
    if (!canvas || canvas.dataset.ready) return;
    canvas.dataset.ready = '1';
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const css = getComputedStyle(document.documentElement);
    const paleta = ['--red', '--yellow', '--green', '--blue', '--violet', '--pink'].map((v) =>
      css.getPropertyValue(v).trim(),
    );
    let nrKoloru = 0;
    let pociagniecia: Pociagniecie[] = [];
    let aktywne: Pociagniecie | null = null;
    let ostatni = 0;
    let raf = 0;

    const resize = () => {
      const dpr = Math.min(devicePixelRatio || 1, 2);
      canvas.width = innerWidth * dpr;
      canvas.height = innerHeight * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    resize();
    addEventListener('resize', resize);

    const dodaj = (x: number, y: number, t: number) => {
      if (!aktywne || t - ostatni > PRZERWA) {
        aktywne = { kolor: paleta[nrKoloru++ % paleta.length], punkty: [] };
        pociagniecia.push(aktywne);
        if (pociagniecia.length > 30) pociagniecia.shift();
      }
      const prev = aktywne.punkty.at(-1);
      let w = GRUBOSC;
      if (prev) {
        // Szybki ruch = cieńsza kreska, jak przy prawdziwym pędzlu
        const v = Math.hypot(x - prev.x, y - prev.y) / Math.max(1, t - prev.t);
        w = GRUBOSC * Math.min(1, Math.max(0.3, 1 - v * 0.12));
        w = prev.w + (w - prev.w) * 0.35;
      }
      aktywne.punkty.push({ x, y, t, w });
      ostatni = t;
    };

    const rysuj = () => {
      const now = performance.now();
      ctx.clearRect(0, 0, innerWidth, innerHeight);
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      for (const p of pociagniecia) {
        while (p.punkty.length && now - p.punkty[0].t > ZANIK) p.punkty.shift();
        const pts = p.punkty;
        ctx.strokeStyle = p.kolor;
        for (let i = 1; i < pts.length - 1; i++) {
          const a = pts[i - 1];
          const b = pts[i];
          const c = pts[i + 1];
          ctx.globalAlpha = Math.max(0, 1 - (now - b.t) / ZANIK);
          ctx.lineWidth = b.w;
          ctx.beginPath();
          ctx.moveTo((a.x + b.x) / 2, (a.y + b.y) / 2);
          ctx.quadraticCurveTo(b.x, b.y, (b.x + c.x) / 2, (b.y + c.y) / 2);
          ctx.stroke();
        }
      }
      pociagniecia = pociagniecia.filter((p) => p.punkty.length);
      raf = pociagniecia.length ? requestAnimationFrame(rysuj) : 0;
    };

    addEventListener(
      'pointermove',
      (e) => {
        if (!ruch.matches || !mysz.matches || e.pointerType !== 'mouse') return;
        // Nie malujemy po obrazach i w powiększeniu – prace mają być dobrze widoczne
        const cel = e.target as Element | null;
        if (cel?.closest?.('img, .pswp, [data-no-paint]')) {
          aktywne = null;
          return;
        }
        const zdarzenia = e.getCoalescedEvents?.() ?? [e];
        for (const z of zdarzenia.length ? zdarzenia : [e]) dodaj(z.clientX, z.clientY, performance.now());
        if (!raf) raf = requestAnimationFrame(rysuj);
      },
      { passive: true },
    );
    document.addEventListener('pointerleave', () => (aktywne = null));
  };

  /* ---------- Przechylanie 3D z odblaskiem ---------- */
  const MAX_TILT = 7;

  const initTilt = () => {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      if (el.dataset.tiltReady) return;
      el.dataset.tiltReady = '1';
      const sheen = Object.assign(document.createElement('span'), { className: 'sheen' });
      sheen.setAttribute('aria-hidden', 'true');
      el.append(sheen);
      let raf = 0;
      el.addEventListener('pointermove', (e) => {
        if (!ruch.matches || e.pointerType !== 'mouse') return;
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = el.getBoundingClientRect();
          const px = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
          const py = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
          el.style.setProperty('--px', `${px * 100}%`);
          el.style.setProperty('--py', `${py * 100}%`);
          el.style.setProperty('--ry', `${(px - 0.5) * 2 * MAX_TILT}deg`);
          el.style.setProperty('--rx', `${(0.5 - py) * 2 * MAX_TILT}deg`);
          el.classList.add('is-tilting');
        });
      });
      el.addEventListener('pointerleave', () => {
        cancelAnimationFrame(raf);
        el.style.setProperty('--rx', '0deg');
        el.style.setProperty('--ry', '0deg');
        el.classList.remove('is-tilting');
      });
    });
  };

  /* ---------- Magnetyczne przyciski ---------- */
  const initMagnetic = () => {
    document.querySelectorAll<HTMLElement>('[data-magnetic]').forEach((el) => {
      if (el.dataset.magReady) return;
      el.dataset.magReady = '1';
      el.addEventListener('pointermove', (e) => {
        if (!ruch.matches || e.pointerType !== 'mouse') return;
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) * 0.25;
        const y = (e.clientY - r.top - r.height / 2) * 0.35;
        el.style.translate = `${x}px ${y}px`;
      });
      el.addEventListener('pointerleave', () => (el.style.translate = ''));
    });
  };

  document.addEventListener('astro:page-load', () => {
    initPaint();
    initTilt();
    initMagnetic();
  });
</script>

<style>
  .paint-trail {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 45;
    pointer-events: none;
    mix-blend-mode: multiply;
    opacity: 0.55;
  }

  /* Pasek postępu przewijania – czysty CSS (scroll-driven animations) */
  .progress {
    display: none;
  }

  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .progress {
        display: block;
        position: fixed;
        inset: 0 0 auto;
        height: 3px;
        z-index: 60;
        background: linear-gradient(90deg, var(--red), var(--yellow), var(--green), var(--blue), var(--violet));
        transform-origin: left;
        animation: postep linear both;
        animation-timeline: scroll(root);
      }
    }
  }

  @keyframes postep {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
